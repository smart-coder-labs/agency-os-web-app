generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model users {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String    @unique @db.VarChar(255)
  password_hash String    @db.VarChar(255)
  full_name     String?   @db.VarChar(255)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
}

model agent_skills {
  agent_id String @db.Uuid
  skill_id String @db.Uuid
  agents   agents @relation(fields: [agent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  skills   skills @relation(fields: [skill_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([agent_id, skill_id])
}

model agent_tools {
  agent_id String @db.Uuid
  tool_id  String @db.Uuid
  agents   agents @relation(fields: [agent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tools    tools  @relation(fields: [tool_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([agent_id, tool_id])
}

model agents {
  id                      String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                    String                 @unique @db.VarChar(100)
  role                    String                 @db.VarChar(50)
  model                   String                 @db.VarChar(100)
  system_prompt           String
  is_active               Boolean?               @default(true)
  agent_skills            agent_skills[]
  agent_tools             agent_tools[]
  execution_logs          execution_logs[]
  agent_jobs              agent_jobs[]
  agent_metrics           agent_metrics[]
  collaborations_sent     agent_collaborations[] @relation("collaborations_sent")
  collaborations_received agent_collaborations[] @relation("collaborations_received")
}

model agent_jobs {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent_id      String    @db.Uuid
  task_name     String    @db.VarChar(255)
  status        String    @db.VarChar(50)
  start_time    DateTime  @default(now()) @db.Timestamptz(6)
  end_time      DateTime? @db.Timestamptz(6)
  duration_ms   Int?
  total_tokens  Int       @default(0)
  input_tokens  Int       @default(0)
  output_tokens Int       @default(0)
  cost_usd      Float     @default(0.0)
  metadata      Json?     @default("{}")
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  agents        agents    @relation(fields: [agent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model agent_metrics {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent_id              String    @db.Uuid
  cpu_usage             Float     @default(0.0)
  memory_usage          Float     @default(0.0)
  active_tokens_per_sec Float     @default(0.0)
  created_at            DateTime? @default(now()) @db.Timestamptz(6)
  agents                agents    @relation(fields: [agent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model architecture_specs {
  project_id      String    @id @db.Uuid
  content         String
  diagrams        Json?     @default("[]")
  stack_decisions Json?     @default("{}")
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  projects        projects  @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model execution_logs {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id String    @db.Uuid
  task_id    String?   @db.Uuid
  agent_id   String?   @db.Uuid
  tool_id    String?   @db.Uuid
  log_type   String?   @default("INFO") @db.VarChar(50)
  title      String?   @db.VarChar(255)
  detail     String?
  metadata   Json?     @default("{}")
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  projects   projects  @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tasks      tasks?    @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  agents     agents?   @relation(fields: [agent_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  tools      tools?    @relation(fields: [tool_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
}

model project_briefs {
  project_id      String    @id @db.Uuid
  content         String
  goals           Json?     @default("[]")
  target_audience String?   @db.VarChar(255)
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)
  projects        projects  @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model projects {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String                 @db.VarChar(255)
  description          String?
  status               String?                @default("DISCOVERY") @db.VarChar(50)
  repo_path            String?                @db.VarChar(255)
  github_path          String?                @db.VarChar(255)
  context_data         Json?                  @default("{}")
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?              @default(now()) @db.Timestamptz(6)
  stitch_project_id    String?
  architecture_specs   architecture_specs?
  project_briefs       project_briefs?
  tasks                tasks[]
  ui_specs             ui_specs?
  user_stories         user_stories[]
  execution_logs       execution_logs[]
  project_artifacts    project_artifacts[]
  stitch_queue         stitch_queue[]
  agent_collaborations agent_collaborations[]
}

model skills {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String         @unique @db.VarChar(100)
  description       String
  parameters_schema Json
  handler_path      String         @db.VarChar(255)
  agent_skills      agent_skills[]
}

model tools {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String           @unique @db.VarChar(100)
  description       String
  parameters_schema Json
  created_at        DateTime?        @default(now()) @db.Timestamptz(6)
  agent_tools       agent_tools[]
  execution_logs    execution_logs[]
}

model task_dependencies {
  task_id                                           String @db.Uuid
  depends_on_task_id                                String @db.Uuid
  tasks_task_dependencies_depends_on_task_idTotasks tasks  @relation("task_dependencies_depends_on_task_idTotasks", fields: [depends_on_task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tasks_task_dependencies_task_idTotasks            tasks  @relation("task_dependencies_task_idTotasks", fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([task_id, depends_on_task_id])
}

model tasks {
  id                                                            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id                                                    String?             @db.Uuid
  title                                                         String              @db.VarChar(255)
  description                                                   String
  type                                                          String              @db.VarChar(50)
  status                                                        String?             @default("TODO") @db.VarChar(50)
  priority                                                      Int?                @default(1)
  assigned_agent_id                                             String?             @db.Uuid
  input_context                                                 Json?               @default("{}")
  output_artifacts                                              Json?               @default("[]")
  git_branches                                                  String[]            @default([])
  pr_links                                                      String[]            @default([])
  agent_commits                                                 String[]            @default([])
  created_at                                                    DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at                                                    DateTime?           @default(now()) @db.Timestamptz(6)
  completed_at                                                  DateTime?           @db.Timestamptz(6)
  task_dependencies_task_dependencies_depends_on_task_idTotasks task_dependencies[] @relation("task_dependencies_depends_on_task_idTotasks")
  task_dependencies_task_dependencies_task_idTotasks            task_dependencies[] @relation("task_dependencies_task_idTotasks")
  projects                                                      projects?           @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  execution_logs                                                execution_logs[]
}

model ui_specs {
  project_id    String    @id @db.Uuid
  design_system Json?     @default("{}")
  components    Json?     @default("[]")
  wireframes_md String?
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  projects      projects  @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model user_stories {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id          String?   @db.Uuid
  title               String    @db.VarChar(255)
  role                String?   @db.VarChar(100)
  goal                String?
  benefit             String?
  acceptance_criteria Json?     @default("[]")
  priority            String?   @db.VarChar(20)
  status              String?   @default("PENDING") @db.VarChar(20)
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  projects            projects? @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model project_artifacts {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id        String    @db.Uuid
  external_name     String?   @db.VarChar(255)
  stitch_project_id String?   @db.VarChar(255)
  stitch_screen_id  String?   @db.VarChar(255)
  title             String?   @db.VarChar(255)
  screenshot_name   String?   @db.VarChar(255)
  screenshot_url    String?
  html_name         String?   @db.VarChar(255)
  html_url          String?
  width             String?   @db.VarChar(50)
  height            String?   @db.VarChar(50)
  device_type       String?   @db.VarChar(50)
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  updated_at        DateTime? @default(now()) @db.Timestamptz(6)
  projects          projects  @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model stitch_queue {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id  String    @db.Uuid
  screen_name String    @db.VarChar(255)
  status      String?   @default("PENDING") @db.VarChar(50)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  projects    projects  @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model agent_collaborations {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id    String    @db.Uuid
  from_agent_id String?   @db.Uuid
  to_agent_id   String?   @db.Uuid
  task_id       String?   @db.Uuid
  content       String?
  type          String?   @db.VarChar(50)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  metadata      Json?     @default("{}")
  projects      projects  @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  from_agent    agents?   @relation("collaborations_sent", fields: [from_agent_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  to_agent      agents?   @relation("collaborations_received", fields: [to_agent_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
}
