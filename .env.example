# Environment
NODE_ENV=development                        # Node environment (development, production, test)

# Database (Prisma)
DATABASE_URL="postgresql://postgres:smartcoder_secret@localhost:5432/agency_os?schema=public"  # Prisma database connection string

# Authentication
NEXTAUTH_SECRET=your-auth-secret-key        # NextAuth.js secret for JWT signing and encryption
AUTH_SECRET=change_me                       # Legacy auth secret (deprecated, use NEXTAUTH_SECRET)

# Backend API
NEXT_PUBLIC_AGENCY_OS_API=http://localhost:3002  # Agency OS backend URL (exposed to client)

